# DOS Chain Safe Wallet - Production Environment
# Copy to .env.production and fill in values

# WalletConnect Project ID (required for wallet connections)
NEXT_PUBLIC_WC_PROJECT_ID=

# Safe Transaction Service / Gateway URL
# For self-hosted: https://safe-txs.doschain.com
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=https://safe-txs.doschain.com/api

# Branding
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
